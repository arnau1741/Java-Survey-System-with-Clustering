        JScrollPane scrollPane = new JScrollPane(panelPrincipal);
        scrollPane.setBorder(null);

        // ========== SECCIÓN 1: Selección de Enquesta ==========
        JPanel panelSeleccion = new JPanel(new BorderLayout(5, 5));
